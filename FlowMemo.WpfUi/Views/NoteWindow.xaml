<Window x:Class="FlowMemo.WpfUi.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FlowMemo.WpfUi.ViewModels"
        xmlns:controls="clr-namespace:FlowMemo.WpfUi.Controls" xmlns:res="clr-namespace:FlowMemo.WpfUi.Resources"
        mc:Ignorable="d"

        BorderThickness="1"
        Icon="/Images/icon.ico"
        MinHeight="75"
        MinWidth="150"
        ResizeMode="CanResize"
        WindowStyle="None"

        FocusManager.FocusedElement="{Binding ElementName=NoteTextBox}"

        Left="{Binding Note.X}"
        Top="{Binding Note.Y}"
        Width="{Binding Note.Width, Mode=TwoWay}"
        Height="{Binding Note.Height, Mode=TwoWay}"
        AllowsTransparency="{Binding Note.TransparencyEnabled}"
        Opacity="{Binding Note.Opacity}"
        ShowInTaskbar="{Binding Note.ShowInTaskbar}"
        Background="{Binding Note.Background}"
        BorderBrush="{Binding Note.BorderBrush}"
        Topmost="{Binding Note.IsPinned}"
        Title="{Binding Note.WindowTitle, Mode=OneWay}"

        d:DataContext="{d:DesignInstance Type=vm:NoteViewModel}"
        d:Height="300"
        d:Width="300"
        d:Background="#fffcdd"
        d:BorderBrush="#feea00">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            GlassFrameThickness="0"
            CornerRadius="0"
            ResizeBorderThickness="7"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Title Bar Buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Control">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Show/Hide Title Bar -->
        <Storyboard x:Key="HideTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ShowTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="28" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar: 높이 28 (예전 40은 메모 크기에 비해 너무 두꺼웠다). 바꾸면 ShowTitleBarAnimation의 To도 같이 바꾼다. -->
        <Grid Name="TitleBarGrid"
              Grid.Column="0"
              Grid.Row="0"
              Height="28"
              Background="{Binding Note.TitleGridBackground}"
              d:Background="#fef7b1">

            <!-- 잠금(읽기 전용) 표시: 예전에는 잠가도 아무 표시가 없어 글자가 안 쳐지는 이유를 알 수 없었다 -->
            <TextBlock Name="LockIndicator"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="42,0,0,0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       Text="&#xE72E;"
                       Foreground="{Binding Note.TitleGridButtonForeground}"
                       ToolTip="{x:Static res:Strings.Note_Locked_ToolTip}"
                       AutomationProperties.Name="{x:Static res:Strings.Note_Locked_ToolTip}"
                       Visibility="{Binding IsReadOnly, ElementName=NoteTextBox, Converter={StaticResource BoolToVisibility}}" />

            <!-- New Note Button -->
            <Button Name="NewButton"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    ToolTip="{x:Static res:Strings.Note_NewNote_ToolTipShortcut}"
                    AutomationProperties.Name="{x:Static res:Strings.Note_NewNote_ToolTip}"
                    Style="{StaticResource TitleBarButtonStyle}">
                <Button.Template>
                    <ControlTemplate>
                        <Canvas>
                            <Rectangle Width="20" Height="20" Fill="Transparent" />
                            <Path Data="M 10,2 v 16 M 2,10 h 16"
                                  Stroke="{Binding Note.TitleGridButtonForeground}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  d:Stroke="#464646">
                            </Path>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Pin Button -->
            <ToggleButton Name="PinButton"
                          HorizontalAlignment="Center"
                          ToolTip="{x:Static res:Strings.Note_Pin_ToolTip}"
                          AutomationProperties.Name="{x:Static res:Strings.Note_Pin_ToolTip}"
                          Style="{StaticResource TitleBarButtonStyle}"
                          IsChecked="{Binding Note.IsPinned}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Canvas>
                            <Rectangle Width="20" Height="20" Fill="Transparent" />
                            <Path Data="M 5,0 h 10 c 1,0 1,2 0,2 h -2 l 1,6 c 0,0 4,1 4,5 0,1 -7,1 -7,1 0,0 0,6 -1,6 C 9,20 9,14 9,14 9,14 2,14 2,13 2,9 6,8 6,8 L 7,2 H 5 C 4,2 4,0 5,0 Z"
                                  Fill="{Binding Note.TitleGridButtonForeground}"
                                  RenderTransformOrigin="0.5,0.5"
                                  d:Fill="#464646">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="False">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="45"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Canvas>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- More Button: 제목 표시줄 우클릭 메뉴(저장·색·메모 관리·설정)를 버튼으로도 연다 -->
            <Button Name="MoreButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,40,0"
                    ToolTip="{x:Static res:Strings.Note_More_ToolTip}"
                    AutomationProperties.Name="{x:Static res:Strings.Note_More_Name}"
                    Style="{StaticResource TitleBarButtonStyle}">
                <Button.Template>
                    <ControlTemplate>
                        <Canvas>
                            <Rectangle Width="20" Height="20" Fill="Transparent" />
                            <Ellipse Canvas.Left="2" Canvas.Top="8.25" Width="3.5" Height="3.5" Fill="{Binding Note.TitleGridButtonForeground}" d:Fill="#464646" />
                            <Ellipse Canvas.Left="8.25" Canvas.Top="8.25" Width="3.5" Height="3.5" Fill="{Binding Note.TitleGridButtonForeground}" d:Fill="#464646" />
                            <Ellipse Canvas.Left="14.5" Canvas.Top="8.25" Width="3.5" Height="3.5" Fill="{Binding Note.TitleGridButtonForeground}" d:Fill="#464646" />
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Close Button -->
            <Button Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0"
                    ToolTip="{x:Static res:Strings.Note_Close_ToolTip}"
                    AutomationProperties.Name="{x:Static res:Strings.Note_Close_ToolTip}"
                    Style="{StaticResource TitleBarButtonStyle}">
                <Button.Template>
                    <ControlTemplate>
                        <Canvas>
                            <Rectangle Width="20" Height="20" Fill="Transparent" />
                            <Path Data="M 3,3 L 17,17 M 3,17 L 17,3"
                                  Stroke="{Binding Note.TitleGridButtonForeground}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  d:Stroke="#464646">
                            </Path>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu Name="TitleBarContextMenu">
                    <MenuItem Header="{x:Static res:Strings.Note_Menu_Save}" Click="SaveMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.Note_Menu_ResetSize}" Click="ResetMenuItem_Click" />
                    <Separator />
                    <!-- Theme options are added dynamically in code behind -->
                    <Separator Name="ThemeMenuSeparator" />
                    <MenuItem Header="{x:Static res:Strings.Note_Menu_Management}" Click="ManagementMenuItem_Click" />
                    <MenuItem Header="{x:Static res:Strings.Note_Menu_Settings}" Click="SettingsMenuItem_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

        </Grid>

        <!-- 동기화 안내: 다른 PC의 변경을 이 메모에서 바로 처리한다. 제목 표시줄을 숨겨도 보인다. -->
        <Border Name="SyncBanner"
                Grid.Column="0"
                Grid.Row="1"
                Padding="8,4,8,5"
                BorderThickness="0,1,0,1"
                Background="{Binding Note.TitleGridBackground}"
                BorderBrush="{Binding Note.BorderBrush}"
                Visibility="{Binding Note.SyncBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel.Resources>
                    <!-- 앱 테마(어두운 테마 포함)가 아니라 메모 색을 따라야 글자가 보인다. -->
                    <Style TargetType="Button">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,3,4,0" />
                        <Setter Property="Foreground" Value="{Binding Note.ContentTextBoxForeground}" />
                        <Setter Property="Background" Value="{Binding Note.Background}" />
                        <Setter Property="BorderBrush" Value="{Binding Note.BorderBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            Padding="9,2"
                                            CornerRadius="3"
                                            BorderThickness="1"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <TextBlock Name="SyncBannerText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{Binding Note.SyncBannerText}"
                           Foreground="{Binding Note.ContentTextBoxForeground}" />

                <WrapPanel Visibility="{Binding Note.SyncShowIncomingActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Name="SyncAcceptButton" Content="{x:Static res:Strings.Sync_Action_Accept}" Click="SyncAcceptButton_Click" />
                    <Button Name="SyncCompareButton" Content="{x:Static res:Strings.Sync_Action_Compare}" Click="SyncCompareButton_Click" />
                    <Button Name="SyncSkipButton" Content="{x:Static res:Strings.Sync_Action_Skip}" Click="SyncSkipButton_Click" />
                </WrapPanel>

                <WrapPanel Visibility="{Binding Note.SyncShowConflictActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Name="SyncResolveButton" Content="{x:Static res:Strings.Sync_Action_Resolve}" Click="SyncCompareButton_Click" />
                </WrapPanel>

                <WrapPanel Visibility="{Binding Note.SyncShowDeletedActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Name="SyncTrashButton" Content="{x:Static res:Strings.Sync_Action_Trash}" Click="SyncTrashButton_Click" />
                    <Button Name="SyncKeepButton" Content="{x:Static res:Strings.Sync_Action_Keep}" Click="SyncKeepButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Text Box -->
        <Grid Grid.Column="0" Grid.Row="2">
            <controls:NoteTextBoxControl BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Note.ContentTextBoxForeground}"
                                         CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                                         FontSize="{Binding EditorSettings.FontSize}"
                                         x:Name="NoteTextBox"
                                         Padding="5,5,5,5"
                                         Text="{Binding Note.Content, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding Note.IsLocked, Mode=TwoWay}"

                                         BackgroundSpellCheck="{Binding EditorSettings.CheckSpelling}"
                                         NewLineAtEnd="{Binding EditorSettings.NewLineAtEnd}"
                                         KeepNewLineAtEndVisible="{Binding EditorSettings.KeepNewLineVisible}"
                                         WrapText="{Binding EditorSettings.WrapText}"

                                         StandardFontFamily="{Binding EditorSettings.StandardFontFamily}"
                                         MonoFontFamily="{Binding EditorSettings.MonoFontFamily}"
                                         UseMonoFont="{Binding EditorSettings.UseMonoFont}"

                                         AutoIndent="{Binding EditorSettings.AutoIndent}"
                                         TabSpaces="{Binding EditorSettings.UseSpacesForTab}"
                                         ConvertIndentation="{Binding EditorSettings.ConvertIndentationOnPaste}"
                                         TabWidth="{Binding EditorSettings.TabSpacesWidth}"

                                         CopyAction="{Binding EditorSettings.CopyAction}"
                                         TrimTextOnCopy="{Binding EditorSettings.TrimTextOnCopy}"
                                         CopyAltAction="{Binding EditorSettings.CopyAltAction}"
                                         TrimTextOnAltCopy="{Binding EditorSettings.TrimTextOnAltCopy}"
                                         CopyFallbackAction="{Binding EditorSettings.CopyFallbackAction}"
                                         TrimTextOnFallbackCopy="{Binding EditorSettings.TrimTextOnFallbackCopy}"
                                         CopyAltFallbackAction="{Binding EditorSettings.CopyAltFallbackAction}"
                                         TrimTextOnAltFallbackCopy="{Binding EditorSettings.TrimTextOnAltFallbackCopy}"
                                         AutoCopy="{Binding EditorSettings.CopyOnSelect}"
                                         PasteAction="{Binding EditorSettings.PasteAction}"
                                         TrimTextOnPaste="{Binding EditorSettings.TrimTextOnPaste}"
                                         PasteAltAction="{Binding EditorSettings.PasteAltAction}"
                                         TrimTextOnAltPaste="{Binding EditorSettings.TrimTextOnAltPaste}"
                                         MiddleClickPaste="{Binding EditorSettings.MiddleClickPaste}" />
        </Grid>
    </Grid>
</Window>
