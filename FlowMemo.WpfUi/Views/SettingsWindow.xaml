<Window x:Class="FlowMemo.WpfUi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FlowMemo.WpfUi.ViewModels"
        xmlns:res="clr-namespace:FlowMemo.WpfUi.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="680"
        Height="480">

    <Grid Margin="5,5,5,5">
        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="16,0,16,0" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- Application Tab -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Application}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Application General Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_General}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding StartupBehaviourList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding ApplicationSettings.StartupBehaviour, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_StartupBehaviour}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding NewInstanceBehaviourList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding ApplicationSettings.NewInstanceBehaviour, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_NewInstanceBehaviour}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ApplicationSettings.ShowNotifyIcon}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_ShowTrayIcon}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ApplicationSettings.CheckForUpdates}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_CheckForUpdates}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Notes Tab -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Notes}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Notes General Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_General}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBox Width="85" MaxLength="4" Text="{Binding NoteSettings.DefaultWidth}" />
                                            <TextBlock Text=" × " />
                                            <TextBox Width="85" MaxLength="4" Text="{Binding NoteSettings.DefaultHeight}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_DefaultSize}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding StartupPositionsList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.StartupPosition, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_StartupPosition}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.PinnedByDefault}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_PinnedByDefault}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding MinimizeModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.MinimizeMode, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_AllowMinimize}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding VisibilityModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.VisibilityMode, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_VisibilityMode}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.HideTitleBar}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_HideTitleBar}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Notes Theme Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_Theme}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteSettings.CycleColours}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_CycleColours}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding ColourModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.ColourMode, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_ColourMode}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Notes Transparency Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_Transparency}">
                            <StackPanel>

                                <TextBlock Grid.Column="0"
                                           Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.Settings_TransparencyNotice}"/>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding TransparencyModeList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding NoteSettings.TransparencyMode, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_TransparencyMode}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsEnabled="{Binding IsTransparencyEnabled}" IsChecked="{Binding NoteSettings.OpaqueWhenFocused}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_OpaqueWhenFocused}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <Slider DockPanel.Dock="Right"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.1"
                                                LargeChange="0.1"
                                                TickPlacement="BottomRight"
                                                Width="150"
                                                IsEnabled="{Binding IsTransparencyEnabled}"
                                                Value="{Binding NoteSettings.OpaqueValue}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" MinWidth="40" TextAlignment="Right"
                                                   Text="{Binding NoteSettings.OpaqueValue, StringFormat={}{0:P0}}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_OpaqueValue}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <Slider DockPanel.Dock="Right"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"
                                                SmallChange="0.1"
                                                LargeChange="0.1"
                                                TickPlacement="BottomRight"
                                                Width="150"
                                                IsEnabled="{Binding IsTransparencyEnabled}"
                                                Value="{Binding NoteSettings.TransparentValue}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" MinWidth="40" TextAlignment="Right"
                                                   Text="{Binding NoteSettings.TransparentValue, StringFormat={}{0:P0}}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_TransparentValue}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Editor Tab -->
            <TabItem Header="{x:Static res:Strings.Settings_Tab_Editor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Editor General Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_General}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.CheckSpelling}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_SpellCheck}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.NewLineAtEnd}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_NewLineAtEnd}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsEnabled="{Binding EditorSettings.NewLineAtEnd}" IsChecked="{Binding EditorSettings.KeepNewLineVisible}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_KeepNewLineVisible}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.WrapText}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_WrapText}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Fonts Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_Fonts}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding FontFamilyList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding EditorSettings.StandardFontFamily, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_StandardFont}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <ComboBox DockPanel.Dock="Right"
                                                  ItemsSource="{Binding FontFamilyList, Mode=OneTime}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding EditorSettings.MonoFontFamily, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_MonoFont}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.UseMonoFont}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_UseMonoFont}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Indentation Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_Indentation}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.AutoIndent}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_AutoIndent}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.UseSpacesForTab}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_UseSpacesForTab}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.ConvertIndentationOnPaste}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_ConvertIndentationOnPaste}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <TextBox DockPanel.Dock="Right" Width="75" MaxLength="2" Text="{Binding EditorSettings.TabSpacesWidth}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_TabWidth}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Editor Copy and Paste Group -->
                        <GroupBox Header="{x:Static res:Strings.Settings_Group_CopyPaste}">
                            <StackPanel>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_CopyAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAltAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnAltCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_CopyAltAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyFallbackActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyFallbackAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnFallbackCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_CopyFallbackAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding CopyFallbackActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.CopyAltFallbackAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnAltFallbackCopy}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_CopyAltFallbackAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.CopyOnSelect}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_AutoCopy}"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding PasteActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.PasteAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnPaste}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_PasteAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right">
                                            <ComboBox ItemsSource="{Binding PasteActionList, Mode=OneTime}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Value"
                                                      SelectedValue="{Binding EditorSettings.PasteAltAction, Mode=TwoWay}" />
                                            <CheckBox Content="{x:Static res:Strings.Settings_TrimText}" IsChecked="{Binding EditorSettings.TrimTextOnAltPaste}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.Settings_PasteAltAction}" VerticalAlignment="Top"/>
                                    </DockPanel>
                                </Border>

                                <Border>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EditorSettings.MiddleClickPaste}" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_MiddleClickPaste}"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Tab_Tools}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="{x:Static res:Strings.Settings_Group_TextTools}">
                    <StackPanel>

                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" FontStyle="Italic"
                                   Text="{x:Static res:Strings.Settings_ToolsNotice}" />

                        <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_ToolGroup_Clean}" />
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.TrimToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Trim}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.RemoveToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Remove}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.JoinToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Join}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SplitToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Split}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SortToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Sort}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.ListToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_List}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.IndentToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Indent}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_ToolGroup_Wrap}" />
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.BracketToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Bracket}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.QuoteToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Quote}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.SlashToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Slash}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.CaseToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Case}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_ToolGroup_Convert}" />
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.Base64ToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Base64}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.UrlToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Url}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.HtmlEntityToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_HtmlEntity}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.JsonToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Json}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.ColourToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Colour}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.HashToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Hash}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_ToolGroup_Insert}" />
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.DateTimeToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_DateTime}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.GuidToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Guid}"/>
                            </DockPanel>
                        </Border>
                        <Border>
                            <DockPanel LastChildFill="True">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding ToolStateList, Mode=OneTime}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding ToolSettings.GibberishToolState, Mode=TwoWay}" />
                                <TextBlock Text="{x:Static res:Strings.Tool_Gibberish}"/>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 설정은 바뀌는 즉시 저장된다. 확인/취소 버튼을 찾지 않도록 알려 주고, 닫기(Esc)를 둔다. -->
        <DockPanel Grid.Row="1" Margin="16,8,16,4" LastChildFill="True">
            <Button x:Name="CloseSettingsButton"
                    DockPanel.Dock="Right"
                    MinWidth="88"
                    IsCancel="True"
                    Content="{x:Static res:Strings.Settings_Close}"
                    Click="CloseSettingsButton_Click" />
            <TextBlock Text="{x:Static res:Strings.Settings_AutoSaveNotice}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>

    </Grid>
</Window>
