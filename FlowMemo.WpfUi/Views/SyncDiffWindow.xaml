<Window x:Class="FlowMemo.WpfUi.Views.SyncDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:FlowMemo.WpfUi.Resources"
        Title="{x:Static res:Strings.SyncDiff_Title}"
        Width="780"
        Height="600"
        MinWidth="520"
        MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- 나란히 보기 머리글. 열 너비는 아래 줄과 맞춘다 (코드에서 만든다). -->
        <Grid Grid.Row="1" Margin="0,0,16,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Margin="40,0,0,0" Text="{x:Static res:Strings.SyncDiff_LocalHeader}" />
            <TextBlock x:Name="RemoteHeaderText" Grid.Column="1" FontWeight="SemiBold" Margin="40,0,0,0" />
        </Grid>

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DiffRowsPanel" />
            </ScrollViewer>
        </Border>

        <!-- 충돌일 때만 보인다: 합친 결과를 확인하고 직접 고칠 수 있다. -->
        <StackPanel x:Name="MergePanel" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SyncDiff_MergedHeader}" />
            <TextBlock x:Name="MergeStatusText" TextWrapping="Wrap" Margin="0,2,0,4" />
            <TextBox x:Name="MergeTextBox"
                     Height="130"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{x:Static res:Strings.SyncDiff_MergedHeader}"
                     TextChanged="MergeTextBox_TextChanged" />
        </StackPanel>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="6,0,0,4" />
                    <Setter Property="Padding" Value="12,5" />
                </Style>
            </WrapPanel.Resources>

            <!-- 충돌 -->
            <Button x:Name="SaveMergedButton" Visibility="Collapsed" Content="{x:Static res:Strings.SyncDiff_SaveMerged}" Click="SaveMergedButton_Click" />
            <Button x:Name="KeepLocalButton" Visibility="Collapsed" Content="{x:Static res:Strings.SyncDiff_KeepLocal}" Click="KeepLocalButton_Click" />
            <Button x:Name="TakeRemoteButton" Visibility="Collapsed" Content="{x:Static res:Strings.SyncDiff_TakeRemote}" Click="TakeRemoteButton_Click" />
            <Button x:Name="KeepBothButton" Visibility="Collapsed" Content="{x:Static res:Strings.SyncDiff_KeepBoth}" Click="KeepBothButton_Click" />

            <!-- 변경 가져오기 -->
            <Button x:Name="AcceptButton" Visibility="Collapsed" Content="{x:Static res:Strings.Sync_Action_Accept}" Click="TakeRemoteButton_Click" />
            <Button x:Name="SkipButton" Visibility="Collapsed" Content="{x:Static res:Strings.Sync_Action_Skip}" Click="SkipButton_Click" />

            <Button x:Name="LaterButton" IsCancel="True" Content="{x:Static res:Strings.SyncDiff_Later}" Click="LaterButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
